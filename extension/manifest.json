{
   "manifest_version": 3,
   "name": "Bank/Credit Union Recruiting Tool",
   "version": "1.0.0",
   "description": "Helps Banks and Credit Unions automate parts of the recruiting process for employees and customers",

   "action":{
      "default_popup": "popup.html"
   },

   "background":{
      "service_worker": "background.js"
   },

   "content_scripts":[
      {
         "js": [
            "content.js"
         ],
         "matches": [
            "https://www.linkedin.com/in/*"
         ]
      }
   ],

   "permissions":[
      "storage",
      "activeTab"
   ],

   "host_permissions":[
      "https://www.linkedin.com/*",
      "http://127.0.0.1:8000/*"
   ]


}